{
  "type": "GenericCrafter",
  "name": "strange-matter-mixer",
  "description": "利用放射性物质辐照冷却液，产生了一种极冷液体，目前仅实验性的用于炮塔冷却。",
  "size": 2,
  "health": 320,
  "category": "crafting",
  "alwaysUnlocked": true,

  "drawer": {
    "type": "DrawMulti",
    "drawers": [
      {
        "type": "DrawRegion",
        "suffix": "-bottom"
      },
      {
        "type": "DrawLiquidTile",
        "drawLiquid": "strange-matter"
      },
      "DrawDefault"
      ]
    },

  // 生产设定
  "craftTime": 120,
  "outputLiquid": {
    "liquid": "strange-matter",
    "amount": 1 
  },

  // 输入消耗
  "consumes": {
    "power": 1.0,
    "items": {
      "items": [
        { "item": "thorium", "amount": 1 }
      ]
    },
    "liquid": {
      "liquid": "cryofluid",
      "amount": 1
    }
  },

  // 液体储存
  "liquidCapacity": 120,

  // 其他属性
  "hasPower": true,
  "hasItems": true,
  "hasLiquids": true,
  "outputsLiquid": true,

  // 建造需求
  "requirements": [
    { "item": "lead", "amount": 65 },
    { "item": "silicon", "amount": 40 },
    { "item": "thorium", "amount": 60 }
  ]
}