{
  type: PowerTurret
  name: "烟花双管"
  description: "这个好好玩！这个好好玩！这个好好玩！这个好好玩！这个好好玩！这个好好玩！这个好好玩！这个好好玩！"

  shootSound: "firework-rocket"

  size: 4
  health: 250

  range: 640
  reload: 60
  rotateSpeed: 20
  shootCone: 15
  inaccuracy: 2

  targetAir: true
  targetGround: true
  targetBlocks: false

  shootType: {
    type: BasicBulletType

    damage: 1
    buildingDamageMultiplier: 0.001

    speed: 16
    lifetime: 32

    width: 6
    height: 8
    frontColor: FF44AA
    backColor: FFCC44

    homingPower: 0.15
    homingRange: 256

    trailColor: FF44AA
    trailLength: 12
    trailWidth: 2

    // 主弹：命中给目标上「燃烧」
    status: "burning"
    statusDuration: 120      // 约 2 秒

    splashDamage: 1
    splashDamageRadius: 16

    // 分裂碎片
    fragBullets: 8
    fragRandomSpread: 360
    fragVelocityMin: 0.8
    fragVelocityMax: 1.5

    fragBullet: {
      type: BasicBulletType

      damage: 1
      buildingDamageMultiplier: 0.001

      speed: 6
      lifetime: 20
      width: 3
      height: 3
      frontColor: FF44AA
      backColor: FFCC44
      trailColor: FFCC44
      trailLength: 6
      trailWidth: 1

      // 分裂弹：命中给目标上「熔化」
      status: "melting"
      statusDuration: 60   // 约 1 秒

      splashDamage: 1
      splashDamageRadius: 8
    }

    shootEffect: shootBigSmoke2

    hitEffect: {
      type: WaveEffect
      lifetime: 25
      sizeFrom: 0
      sizeTo: 48
      strokeFrom: 4
      strokeTo: 0
      colorFrom: FF44AA
      colorTo: FFCC44
    }
  }

  consumes: {
    power: 0.1
  }

  requirements: [
    copper/1
  ]

  category: turret
  alwaysUnlocked: true
}